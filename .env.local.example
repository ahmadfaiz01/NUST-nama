# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by /api/webhooks/ingest-event to bypass RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# OAuth callback base URL, e.g. http://localhost:3000 or https://nustnama.vercel.app
NEXT_PUBLIC_APP_URL=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Chat provider chain, tried in this order. All three speak the OpenAI API.
# Any that are blank are skipped. Chat only — embeddings never fall back, since a
# query embedded by a different model lands nowhere near its sections.
GROQ_API_KEY=
GROQ_API_KEY_2=
MISTRAL_API_KEY=
# Gemini is not served in Pakistan - returns 403 "project has been denied access"
GEMINI_API_KEY=

# Shared secret n8n sends as the x-api-secret header (optional)
INGEST_API_SECRET_KEY=
