# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by /api/webhooks/ingest-event to bypass RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# OAuth callback base URL, e.g. http://localhost:3000 or https://nustnama.vercel.app
NEXT_PUBLIC_APP_URL=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Groq - news "student tone" rewriter in /admin/news (optional)
GROQ_API_KEY=

# Shared secret n8n sends as the x-api-secret header (optional)
INGEST_API_SECRET_KEY=
